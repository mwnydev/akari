  "query": "INSERT INTO withdraw_addresses (user_id, chain_id, address, label, active_at)\n           VALUES ($1, $2, $3, $4, now() + make_interval(secs => $5::bigint::float8))\n           RETURNING id, address, label, active_at, revoked_at, created_at, active_at <= now() AS \"active!\"",
