  "query": "SELECT c.id, c.post_id, c.author_id, c.status, left(c.body, 200) AS \"excerpt!\",\n                  p.topic_id, p.floor, t.title, t.forum_id\n           FROM floor_comments c JOIN posts p ON p.id = c.post_id JOIN topics t ON t.id = p.topic_id\n           WHERE c.id = ANY($1)",
