DATABASE_URL=postgres://akari:akari-dev-only@127.0.0.1:5432/akari
VALKEY_URL=redis://127.0.0.1:6379
# 共用一个 Valkey 的多个本地检出：各用不同的数据库号（URL 末尾 /N）并设不同的 KV_PREFIX，
# 否则 Pub/Sub 推送会串到别的检出（频道不按数据库隔离）。生产留空。
KV_PREFIX=
# forum-api 部署环境：production（域名固定为 ADR 0012 正式域名，不读 ALLOWED_ORIGINS / INTERNAL_HOSTS /
# WALLET_RP_ID / WALLET_ORIGINS / ADMIN_RP_ID / ADMIN_ORIGIN / RULING_RP_ID / RULING_ORIGIN）、staging（全部 https）、development（默认；允许本机 http 与 COOKIE_SECURE=false）
AKARI_ENV=development
# Cloudflare Turnstile 密钥：登录验证码与注册 24 小时内的发帖 / 回帖 / 评论都校验（经 siteverify，出网目标固定）。
# 只有 AKARI_ENV=development 可以留空（不校验并打印警告）；staging / production 缺了拒绝启动。
# 前端对应 NEXT_PUBLIC_TURNSTILE_SITE_KEY（apps/forum/.env.example）。
# TURNSTILE_SECRET=
# 钱包 Passkey（plan 第 5 节）：RP ID = 钱包中心域名；WALLET_ORIGINS 第一个须在 RP ID 之下，其余为关联来源。
WALLET_RP_ID=localhost
WALLET_ORIGINS=http://localhost:3001
BRAND_NAME=Akari
# 站长后台 Passkey（ADR 0012、0013）：生产固定为 administrator.akari.cc / https://administrator.akari.cc（不读这两项）。
# RP ID 必须覆盖 ADMIN_ORIGIN，绝不能是 akari.cc、论坛主机或其父域名，也不能与 WALLET_RP_ID 相同（启动时校验）。
ADMIN_RP_ID=localhost
ADMIN_ORIGIN=http://localhost:3002
# forum-worker：管理员 Telegram 群告警（管理人员新设备登录、异常管理操作、任免、仲裁告警等）。两项都设置才启用，都不设置则关闭。
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ADMIN_CHAT_ID=-1001234567890
# 论坛裁决 Passkey（ADR 0012、0013）：只用于站长 / 管理员签署仲裁裁决，与钱包 Passkey 是两组凭证。
# 生产固定为 RULING_RP_ID=akari.cc、RULING_ORIGIN=https://akari.cc（不读这两项）；RP ID 必须等于 RULING_ORIGIN 的主机、
# 不能等于 WALLET_RP_ID（本地开发都用 localhost 除外），RULING_ORIGIN 必须在 ALLOWED_ORIGINS 里、不能是钱包来源。
# ARBITRATION_SAFE（可选）= 仲裁 Safe 地址，写进给签名人导入的 Safe 交易文件。
RULING_RP_ID=localhost
RULING_ORIGIN=http://localhost:3000
# ARBITRATION_SAFE=
# forum-worker：仲裁员接案（举证期结束起算）后多久不裁决就改派，默认 48 小时。
# ARBITRATION_RULING_DEADLINE_HOURS=48
# 担保合约所在链：CHAIN_CONFIG 指向链配置文件（格式见 crates/chain/chain.example.toml，与 forum-indexer 同一份，
# RPC 地址用 CHAIN_RPC_PRIMARY_HTTP 等提供）时，链 ID、合约、代币与钱包初始化参数版本都取自它，登记钱包地址时
# 经 RPC 校验地址（ADR 0008）。未设置时钱包地址不能登记，链参数取下面三项（只用于不接链的本地开发；
# 与 CHAIN_CONFIG 同时设置会拒绝启动）；合约与 USDT 地址未配置时报价接口不可用。
CHAIN_CONFIG=
# CHAIN_ID=421614
# ESCROW_ADDRESS=
# USDT_ADDRESS=
# 链上当前参数（USDT 最小单位 / bps），默认即 plan 第 9 节初始值：
# TRADE_MIN_ORDER=5000000 TRADE_ORDER_CAP=200000000 TRADE_FEE_BPS=100 TRADE_MIN_FEE=1000000 TRADE_BASE_GAS=100000
# forum-api → 本机 forum-sponsor（代付签名与代发）：SPONSOR_URL 与 SPONSOR_API_TOKEN 都设置才启用 /api/v1/aa/rpc。
# forum-sponsor 另需 CHAIN_CONFIG（含 [aa]）、SPONSOR_LISTEN（默认 127.0.0.1:8090）与同一个令牌；私钥生产由
# systemd 凭据 paymaster-signer / relayer-hot-wallet 提供，本地用 SPONSOR_DEV_PAYMASTER_KEY / SPONSOR_DEV_HOT_WALLET_KEY；
# 拍卖成交证明私钥 auction-signer 可选（本地 SPONSOR_DEV_AUCTION_KEY），没有时拍卖无法成交。
# forum-worker 结算拍卖要 CHAIN_CONFIG 与同样的 SPONSOR_URL / SPONSOR_API_TOKEN（可选 AUCTION_DEFAULT_GRACE_SECS=300）。
# 本地 AA 开发链：deploy/dev/aa.sh up 生成 deploy/dev/chain.local.toml 与上面这些变量（deploy/dev/.env.aa），见 README-aa.md。
# 可选：SPONSOR_FEE=50000（上限 1000000）SPONSOR_BATCH_WINDOW_MS=150 SPONSOR_MAX_OP_COST_WEI
#       SPONSOR_ALERT_DEPOSIT_WEI SPONSOR_ALERT_HOT_WALLET_WEI FALLBACK_BUNDLER_URL=http://127.0.0.1:4337
# 图片上传（plan 第 12 节，forum-api 与 forum-worker）：生产为 Cloudflare R2（区域 auto），存储桶对 tmp/ 前缀配置 1 天过期的
# 生命周期规则；MEDIA_PUBLIC_BASE 是正式目录的公开地址（CDN 域名），帖子里只允许这个主机的图片。都不设置则上传不可用。
# 本地：docker compose -f deploy/dev/compose.yaml up -d s3（SeaweedFS，S3_PORT 默认 8333）
# MEDIA_S3_ENDPOINT=http://127.0.0.1:8333
# MEDIA_S3_BUCKET=akari-dev
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ACCESS_KEY=akari-dev
# MEDIA_S3_SECRET_KEY=akari-dev-only-secret
# MEDIA_PUBLIC_BASE=http://127.0.0.1:8333/akari-dev/
# MEDIA_S3_CREATE_BUCKET=true   # 只用于本地：forum-worker 启动时建存储桶
# forum-indexer 也读 VALKEY_URL：订单最终确认后失效双方的用户名片缓存（未设置时名片 1 小时内过期刷新）。
