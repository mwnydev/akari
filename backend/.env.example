DATABASE_URL=postgres://akari:akari-dev-only@127.0.0.1:5432/akari
VALKEY_URL=redis://127.0.0.1:6379
# 钱包 Passkey（plan 第 5 节）：RP ID = 钱包中心域名；WALLET_ORIGINS 第一个须在 RP ID 之下，其余为关联来源。
WALLET_RP_ID=localhost
WALLET_ORIGINS=http://localhost:3001
BRAND_NAME=Akari
# 担保合约所在链：CHAIN_CONFIG 指向链配置文件（格式见 crates/chain/chain.example.toml，与 forum-indexer 同一份，
# RPC 地址用 CHAIN_RPC_PRIMARY_HTTP 等提供）时，链 ID、合约、代币与钱包初始化参数版本都取自它，登记钱包地址时
# 经 RPC 校验地址（ADR 0008）。未设置时钱包地址不能登记，链参数取下面三项（只用于不接链的本地开发；
# 与 CHAIN_CONFIG 同时设置会拒绝启动）；合约与 USDT 地址未配置时报价接口不可用。
CHAIN_CONFIG=
# CHAIN_ID=421614
# ESCROW_ADDRESS=
# USDT_ADDRESS=
# 链上当前参数（USDT 最小单位 / bps），默认即 plan 第 9 节初始值：
# TRADE_MIN_ORDER=5000000 TRADE_ORDER_CAP=200000000 TRADE_FEE_BPS=100 TRADE_MIN_FEE=1000000 TRADE_BASE_GAS=100000
