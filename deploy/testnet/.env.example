# deploy/testnet/testnet.sh 的配置模板：复制成 deploy/testnet/.env（不入库）再填写。步骤见 docs/runbooks/testnet-deploy.md。
# 这里只放地址与文件路径，不放任何密钥（脚本发现 *_KEY / *PASSWORD / *SECRET 赋值会拒绝运行）。

# RPC 与 Arbiscan 密钥文件（权限 0600，KEY=VALUE 每行一个，脚本只读不执行）：
#   ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia.infura.io/v3/<密钥>        主节点（必填）
#   ARBITRUM_SEPOLIA_RPC_BACKUP_URL=https://arb-sepolia.g.alchemy.com/v2/<密钥>   备用节点（可选）
#   ARBITRUM_SEPOLIA_WS_URL=wss://arbitrum-sepolia.infura.io/ws/v3/<密钥>         主节点 WebSocket（可选，只做连通检查）
#   ARBISCAN_API_KEY=<Etherscan API v2 密钥>                                     有它 deploy 才在 Arbiscan 验证源码
RPC_SECRETS_FILE=~/secrets/akari-arbitrum-sepolia.env

# 部署账户（只需测试网 ETH；不兼任任何角色）。三选一：
#   DEPLOYER_ACCOUNT=<~/.foundry/keystores 下的密钥库名>（cast wallet import <名字> --interactive 生成）
#   DEPLOYER_KEYSTORE=<密钥库文件路径>
#   DEPLOYER_LEDGER=1（Ledger 的第一个账户）
# 密钥库口令默认每次交互输入；无人值守时 DEPLOYER_PASSWORD_FILE=<0600 口令文件>。
DEPLOYER_ACCOUNT=akari-testnet-deployer
DEPLOYER_ADDRESS=

# Safe（docs/runbooks/testnet-deploy.md「建 Safe」）。OWNERS 逗号分隔、不分大小写与顺序，preflight / verify 逐一核对。
# 仲裁 Safe：Escrow / StreamEscrow 的 arbiter（ADR 0013：2 名管理员 + 站长，任意 2 人）。
ARBITER_SAFE=
ARBITER_SAFE_OWNERS=
ARBITER_SAFE_THRESHOLD=2
# 金库 Safe：EscrowConfig owner（改参数、72 小时排队）、feeRecipient、Paymaster treasury（站长的 3 个设备，任意 2 个）。
TREASURY_SAFE=
TREASURY_SAFE_OWNERS=
TREASURY_SAFE_THRESHOLD=2
# 运营 Safe：FixedFeePaymaster owner（质押、换代付签名者、取回押金；测试网站长单独执行，主网部署脚本要求 2/3）。
OPS_SAFE=
OPS_SAFE_OWNERS=
OPS_SAFE_THRESHOLD=1

# forum-sponsor 的三把热密钥的地址（私钥在服务器 systemd 凭据里，见 deploy/README.md）。
PAYMASTER_SIGNER=
RELAYER_ADDRESS=
# 拍卖成交证明签名者（EscrowConfig.auctionSigner）；留空 = 拍卖关闭。
AUCTION_SIGNER=

# 代币：留空 = 部署 MockUSDT（任何人可 mint，测试网专用）；填已有的 6 位小数测试代币地址则直接使用。
TOKEN=

# configure 的目标值（ETH）。部署账户补押金与热钱包；质押由运营 Safe 执行（Transaction Builder 文件）。
# 押金与热钱包必须高于 forum-sponsor 的告警线（SPONSOR_ALERT_DEPOSIT_WEI / SPONSOR_ALERT_HOT_WALLET_WEI，默认 0.05 / 0.01 ETH，
# 热钱包低于告警线时代发器视为不健康）。测试网 ETH 紧张时两边一起调低：下面两项写成服务器上配置的告警线（ETH）。
PAYMASTER_DEPOSIT=0.1
RELAYER_FUND=0.02
SPONSOR_ALERT_DEPOSIT=0.05
SPONSOR_ALERT_HOT_WALLET=0.01
PAYMASTER_STAKE=0.01
PAYMASTER_UNSTAKE_DELAY=86400

# emit-config 写进后端链配置的 indexer 补拉间隔（毫秒，默认 20000 与生产相同，Infura 免费档约 175 万 credits / 天）。
# 见 runbook「RPC 用量」。
INDEXER_RECONCILE_MS=20000

# 输出位置（默认值如下，入库）：部署记录、forge 广播、Safe 交易文件、后端链配置；前端链配置。
# STATE_DIR=deploy/testnet/deployments/arbitrum-sepolia
# FRONTEND_CHAIN_JSON=frontend/packages/contracts/src/chain.arbitrum-sepolia.json

# 只用于本机 fork 演练（deploy/testnet/rehearse.sh 设置）：本机 RPC 代替 RPC_SECRETS_FILE，不做源码验证。
# RPC_URL=http://127.0.0.1:8345

# 统计真实网络上的 RPC 用量：RPC_METER_URL=http://127.0.0.1:<端口>（本机 rpc-meter.py，上游 = 主节点）。它不写在这里，
# 运行前在环境里 export（见 runbook「统计 RPC 用量」）；deploy/testnet/safe.sh 也认它。
