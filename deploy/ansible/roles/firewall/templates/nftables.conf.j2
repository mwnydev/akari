#!/usr/sbin/nft -f
# {{ ansible_managed }}
flush ruleset

table inet filter {
{% if origin_ingress == 'direct' %}
  set cloudflare_v4 { type ipv4_addr; flags interval; elements = { {{ firewall_cf_v4 | join(', ') }} } }
  set cloudflare_v6 { type ipv6_addr; flags interval; elements = { {{ firewall_cf_v6 | join(', ') }} } }
{% endif %}

  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    # 只收网络正常工作所需的 ICMP（不回 ping），DHCP 续租
    icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
{% set ssh_v6 = firewall_ssh_bootstrap_allow | select('search', ':') | list %}
{% set ssh_v4 = firewall_ssh_bootstrap_allow | reject('search', ':') | list %}
{% if ssh_v4 %}
    # WARNING 临时放行公网 SSH（firewall_ssh_bootstrap_allow），用完不带该变量重跑关闭
    ip saddr { {{ ssh_v4 | join(', ') }} } tcp dport {{ ssh_port }} accept
{% endif %}
{% if ssh_v6 %}
    # WARNING 临时放行公网 SSH（firewall_ssh_bootstrap_allow），用完不带该变量重跑关闭
    ip6 saddr { {{ ssh_v6 | join(', ') }} } tcp dport {{ ssh_port }} accept
{% endif %}
{% if origin_ingress == 'direct' %}
    ip saddr @cloudflare_v4 tcp dport 443 accept
    ip6 saddr @cloudflare_v6 tcp dport 443 accept
{% endif %}
  }

  chain forward { type filter hook forward priority 0; policy drop; }

  # 出站按端口放行，不按主机名（RPC、R2、邮件 API 的 IP 会变）。哪些代码可以出网由代码审查与
  # backend/crates/runtime/tests/outbound_clients.rs 把关；SMTP 端口不在其中，生产只用 HTTP API 发信。
  chain output {
    type filter hook output priority 0; policy {{ 'drop' if firewall_egress_enforce else 'accept' }};
    oif lo accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { icmp, ipv6-icmp } accept
    # DNS、DHCP、NTP（chrony）
    meta l4proto { tcp, udp } th dport 53 accept
    udp dport { 67, 123, 547 } accept
    # HTTPS：RPC、R2、Turnstile、Bundler、邮件 API、Telegram、GitHub 构建证明、Cloudflare、软件源
    tcp dport { 443{% for p in firewall_egress_extra_tcp_ports %}, {{ p }}{% endfor %} } accept
    # cloudflared 连 Cloudflare 边缘（QUIC，失败时回落 HTTP/2）
    meta l4proto { tcp, udp } th dport 7844 accept
    # Debian 软件源默认走 http（apt 自己验签），只放行 apt 的下载账号
    meta skuid "_apt" tcp dport 80 accept
{% if firewall_egress_enforce %}
    limit rate 6/minute burst 10 packets log prefix "akari egress blocked: " level warn
    reject with icmpx type admin-prohibited
{% endif %}
  }
}
