{
  "version": 1,
  "unit": "USDT smallest unit (6 decimals); all amounts are decimal strings",
  "rules": {
    "fee": "total = campaign ? floor(amount*feeBps/10000) : max(floor(amount*feeBps/10000), minFee)",
    "split": "seller: (0,total); buyer: (total,0); half: buyer=floor(total/2), seller=total-buyer. Applies to fee and baseGas",
    "buyerPays": "amount + buyerFee + buyerGas",
    "disputeFee": "floor((feeTotal>0 ? feeTotal : minFee) * disputeMulBps / 10000)",
    "streamNet": "amount - sellerFee - sellerGas",
    "streamUnlocked": "floor(net * min(elapsedPeriods, periods) / periods)",
    "claim": "claimable = unlocked - claimed; requires claimable > claimGas; seller receives claimable - claimGas",
    "cnyToUsdt": "CNY auctions (ADR 0011): usdt = ceil(priceFen * 10^8 / cnyPerUsdt); cnyPerUsdt has 4 decimals (7.2000 = 72000) and must lie in [minCnyPerUsdt, maxCnyPerUsdt]; 10^8 = 10^6 (USDT units) * 10^4 (rate decimals) / 100 (fen per yuan)",
    "cnyReference": "listing reference price (display only): fen = floor(usdt * cnyPerUsdt / 10^8)"
  },
  "claimGas": "20000",
